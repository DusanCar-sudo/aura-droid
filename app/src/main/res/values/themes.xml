<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pre-Compose window theme. windowBackground is Aura forest so launch does not
      flash white before AuraDroidTheme (dark by default) takes over.
    -->
    <style name="Theme.AuraDroid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aura_forest</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch theme (androidx core-splashscreen): the peak on forest while the
      process starts, then hands over to Theme.AuraDroid. The in-app brand
      splash with the AURA DROID wordmark takes over from here.
    -->
    <style name="Theme.AuraDroid.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aura_forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AuraDroid</item>
    </style>
</resources>
